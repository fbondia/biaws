# Persistência da API do Bondia Workspaces
MONGO_URI=mongodb://127.0.0.1:27017/biaws
MONGO_DB=biaws
MONGO_PORT=27017
ISSUE_DIR=./issue-data/issues
REQUEST_DIR=./issue-data/requests
DOCUMENT_DIR=./issue-data/documents
ATTACHMENT_STORAGE_PROVIDER=local
BIAWS_SECRETS_PROVIDER=local
# Execução local sem Docker: diretório criptografado e arquivo binário de 32 bytes.
BIAWS_SECRETS_DIR=./secrets-data
BIAWS_SECRETS_KEY_FILE=./.secrets-master-key
BIAWS_SECRETS_MAX_FILE_BYTES=5242880

# Opcional. Por padrão, o provider local usa ISSUE_DIR.
# ATTACHMENT_STORAGE_LOCAL_DIR=./issue-data/issues

# Armazenamento Docker. Vazios usam volumes nomeados gerenciados pelo Docker.
# Para bind mounts, informe caminhos absolutos no host. O setup-agent preenche
# estes valores quando recebe --storage-dir ou uma das opções específicas.
BIAWS_MONGO_DATA_PATH=
BIAWS_ISSUE_FILES_PATH=
BIAWS_REQUEST_FILES_PATH=
BIAWS_DOCUMENT_FILES_PATH=
BIAWS_SECRET_FILES_PATH=
# Caminho no host usado pelo Compose. O bootstrap gera e preenche este arquivo.
BIAWS_SECRETS_KEY_PATH=

# Servidor HTTP
ISSUE_API_HOST=127.0.0.1
ISSUE_API_PORT=3100
ISSUE_UI_PORT=4400
ISSUE_API_MAX_ATTACHMENT_BYTES=52428800
ISSUE_API_MAX_JSON_BYTES=4194304
# Health checks são omitidos dos logs de acesso por padrão para evitar ruído.
ISSUE_API_LOG_HEALTH_REQUESTS=false

# Rate limiting geral das rotas protegidas (por usuário ou API key).
ISSUE_API_RATE_LIMIT_ENABLED=true
ISSUE_API_RATE_LIMIT_WINDOW_SECONDS=60
ISSUE_API_RATE_LIMIT_MAX_REQUESTS=300

# Rate limiting dos endpoints do Better Auth (por IP e rota).
BETTER_AUTH_RATE_LIMIT_ENABLED=true
BETTER_AUTH_RATE_LIMIT_WINDOW_SECONDS=10
BETTER_AUTH_RATE_LIMIT_MAX_REQUESTS=100

# Cota persistente gravada em cada API key.
ISSUE_API_KEY_RATE_LIMIT_ENABLED=true
ISSUE_API_KEY_RATE_LIMIT_WINDOW_SECONDS=3600
ISSUE_API_KEY_RATE_LIMIT_MAX_REQUESTS=1000

# Consumidor HTTP do Bondia Workspaces MCP
ISSUE_API_URL=http://127.0.0.1:3100
# Chave usada pelo MCP e pela CLI após criação na UI.
ISSUE_API_KEY=
# O workspace não pertence à instância. O setup o grava na configuração MCP
# local de cada projeto consumidor.

# Executor independente de monitoramento ativo. O profile `active-monitoring`
# do Compose permanece desligado até ser selecionado explicitamente. Use uma
# chave técnica dedicada com `monitoring.active.execute`; não reutilize ou
# versione uma chave real.
BIAWS_MONITOR_EXECUTOR_ENABLED=true
BIAWS_MONITOR_EXECUTOR_API_KEY=
BIAWS_MONITOR_EXECUTOR_API_KEY_FILE=/run/secrets/executor-api-key
BIAWS_MONITOR_EXECUTOR_WORKSPACE_ID=
# O bootstrap substitui estes valores pelo proprietário dos arquivos secretos.
BIAWS_MONITOR_EXECUTOR_UID=1000
BIAWS_MONITOR_EXECUTOR_GID=1000
BIAWS_MONITOR_EXECUTOR_CONCURRENCY=4
# Políticas locais deny-by-default dos providers. Não versione valores secretos;
# referencie-os no mapa e injete a variável mapeada no executor.
BIAWS_MONITOR_EXECUTOR_EVIDENCE_MAX_BYTES=8000
BIAWS_MONITOR_REST_ALLOWED_HOSTS=
BIAWS_MONITOR_REST_ALLOWED_METHODS=GET,HEAD
BIAWS_MONITOR_REST_ALLOW_PRIVATE_ADDRESSES=false
BIAWS_MONITOR_REST_MAX_REDIRECTS=3
BIAWS_MONITOR_REFERENCE_ENV_MAP={}
BIAWS_MONITOR_REFERENCE_FILE_MAP={}
BIAWS_MONITOR_SECRET_FILES_PATH=
BIAWS_MONITOR_SHELL_ROOT=/opt/biaws-monitor-scripts
BIAWS_MONITOR_SHELL_SCRIPTS={}
BIAWS_MONITOR_SHELL_FILES_PATH=

# Identidade técnica criada pelo bootstrap para MCP e CLI.
# BIAWS_BOOTSTRAP_AGENT_EMAIL=agent@localhost.invalid
# BIAWS_BOOTSTRAP_AGENT_NAME=Bondia Workspaces Agent

# Autenticação. Gere um segredo com ao menos 32 caracteres, por exemplo:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:4400
# CIDRs/IPs dos proxies confiáveis, separados por vírgula. Deixe vazio quando
# não houver uma cadeia adicional de proxies na frente do Nginx da aplicação.
BETTER_AUTH_TRUSTED_PROXIES=
# Use true quando a URL pública usar HTTPS. Em NODE_ENV=production, o padrão da
# API é true; o ambiente Docker local sobrescreve para false.
BETTER_AUTH_SECURE_COOKIES=false

# URL pública usada pelo ambiente Docker. Altere se publicar atrás de outro host.
BIAWS_PUBLIC_URL=http://localhost:4400
BIAWS_TRUSTED_ORIGINS=http://localhost:4400,http://127.0.0.1:4400

# Informe somente ao executar `npm run bootstrap:admin` no componente `biaws-api`.
# Não persista a senha real neste arquivo.
# BIAWS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BIAWS_BOOTSTRAP_ADMIN_NAME=Administrador
# BIAWS_BOOTSTRAP_ADMIN_PASSWORD=
