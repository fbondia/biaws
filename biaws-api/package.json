{
  "name": "@bondia/biaws-api",
  "version": "0.5.0",
  "description": "API do Bondia Workspaces para chamados, melhorias e conhecimento operacional",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbondia/biaws.git",
    "directory": "biaws-api"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node dist/biaws-api/src/index.js",
    "dev": "tsx watch src/index.ts",
    "bootstrap:admin": "node dist/biaws-api/src/scripts/bootstrapAdmin.js",
    "bootstrap:agent": "node dist/biaws-api/src/scripts/bootstrapAgent.js",
    "bootstrap:monitor-executor": "node dist/biaws-api/src/scripts/bootstrapMonitorExecutor.js",
    "seed:skills": "node dist/biaws-api/src/scripts/seedStarterSkills.js",
    "seed:demo": "node dist/biaws-api/src/scripts/seedDemo.js",
    "migrate:journeys": "node dist/biaws-api/src/scripts/migrateJourneyModel.js",
    "migrate:monitoring": "node dist/biaws-api/src/scripts/migrateRuntimeMonitoring.js",
    "migrate:documents": "node dist/biaws-api/src/scripts/migrateProceduresToDocuments.js",
    "format": "prettier --config ../prettier/.prettierrc --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../prettier/.prettierrc --ignore-path ../.prettierignore --check .",
    "check": "npm run typecheck",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "test:unit": "node scripts/test.mjs --layer=unit",
    "test:integration": "node scripts/test.mjs --layer=mongo",
    "test:http": "node scripts/test.mjs --layer=http",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "node --import tsx scripts/openapi.mjs --write",
    "openapi:check": "node --import tsx scripts/openapi.mjs --check",
    "test:compiled": "npm run build:test && node scripts/test.mjs --compiled",
    "build:test": "node scripts/build.mjs --tests"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@better-auth/api-key": "1.7.5",
    "@better-auth/mongo-adapter": "1.7.5",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonata": "2.2.2",
    "mailparser": "^3.9.28",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/mailparser": "3.9.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "@types/swagger-ui-express": "4.1.8",
    "prettier": "^3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
