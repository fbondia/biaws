[
  {
    "from": "topologyRepository.test.js",
    "to": "catalog/normalization.test.js",
    "tests": [
      "topology permissions are part of the canonical catalog",
      "scoped topology filters escape search and pagination is bounded"
    ]
  },
  {
    "from": "topologyRepository.test.js",
    "to": "components/normalization.test.js",
    "tests": [
      "component relationships are normalized and duplicate references are rejected"
    ]
  },
  {
    "from": "topologyRepository.test.js",
    "to": "repositories/normalization.test.js",
    "tests": [
      "repository URL rejects credentials and secret query parameters",
      "repository URL and identifier are mutable"
    ]
  },
  {
    "from": "topologyRepository.test.js",
    "to": "servers/normalization.test.js",
    "tests": [
      "server payload limits lifecycle changes and credential-bearing addresses"
    ]
  },
  {
    "from": "topologyRepository.test.js",
    "to": "deployments/normalization.test.js",
    "tests": [
      "deployment keeps its component immutable and validates source shape",
      "deployment publications are append-only and materialize the latest release",
      "deployment publication status is validated and can be updated"
    ]
  },
  {
    "from": "topologyRepository.test.js",
    "to": "runtimes/normalization.test.js",
    "tests": [
      "runtime metadata is flat, bounded and rejects secret-like keys",
      "runtime defaults monitoring retention and rejects embedded observations"
    ]
  },
  {
    "from": "topologyRepository.test.js",
    "to": "monitoring/normalization.test.js",
    "tests": [
      "active monitor configuration is bounded and secret-free",
      "active monitor lease requests require a bounded executor identity",
      "monitoring signals validate status, idempotency key and secret-free metadata",
      "monitoring metadata profiles validate their versioned field contract",
      "monitoring payload accepts bounded nested JSON and rejects sensitive keys",
      "monitoring expiration follows runtime retention and supports no expiration",
      "manual monitoring observations use the unified event contract",
      "monitoring signal history filters status and observed date range",
      "monitoring health summary bounds long ranges with an effective resolution",
      "monitoring health summary pipeline keeps the worst state in each bucket",
      "monitoring health summary returns compact series and aggregate counts"
    ]
  },
