{
  "name": "biaws",
  "version": "0.1.0",
  "description": "CLI do Bondia Workspaces para configuração do ambiente local",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbondia/biaws.git",
    "directory": "biaws-cli"
  },
  "homepage": "https://github.com/fbondia/biaws#readme",
  "bugs": {
    "url": "https://github.com/fbondia/biaws/issues"
  },
  "keywords": [
    "biaws",
    "bondia-workspaces",
    "cli",
    "oclif"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "biaws": "bin/biaws.js"
  },
  "files": [
    "bin",
    "docs",
    "LICENSE",
    "shared",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "biaws",
    "dirname": "biaws",
    "commands": "./src/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "start": "node bin/biaws.js",
    "format": "prettier --config ../prettier/.prettierrc --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../prettier/.prettierrc --ignore-path ../.prettierignore --check .",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "package:verify": "node scripts/verify-package.mjs",
    "release:check": "npm run format:check && npm run check && npm test && npm run package:verify",
    "publish:npm": "../scripts/publish-biaws-cli.sh",
    "prepack": "npm run package:verify"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@oclif/core": "^4.13.5"
  }
}
