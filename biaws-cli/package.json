{
  "name": "biaws",
  "version": "0.2.0",
  "description": "CLI do Bondia Workspaces para administração, configuração e operação de workspaces",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbondia/biaws.git",
    "directory": "biaws-cli"
  },
  "homepage": "https://github.com/fbondia/biaws#readme",
  "bugs": {
    "url": "https://github.com/fbondia/biaws/issues"
  },
  "keywords": [
    "biaws",
    "bondia-workspaces",
    "cli",
    "oclif"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "biaws": "bin/biaws.js"
  },
  "files": [
    "bin",
    "docs",
    "LICENSE",
    "shared",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "biaws",
    "dirname": "biaws",
    "commands": "./src/cli",
    "topicSeparator": " ",
    "topics": {
      "admin": {
        "description": "Administra a instalação e as instâncias da plataforma",
        "subtopics": {
          "instance": {
            "description": "Configura e opera instâncias locais do BIAWS"
          },
          "monitoring": {
            "description": "Configura e opera executores de monitoramento"
          }
        }
      },
      "config": {
        "description": "Gerencia perfis, URLs e credenciais globais",
        "subtopics": {
          "profiles": {
            "description": "Gerencia os perfis globais de acesso"
          }
        }
      },
      "workspace": {
        "description": "Associa a pasta e opera os recursos do workspace",
        "subtopics": {
          "agent": {
            "description": "Configura e diagnostica clientes de agentes",
            "subtopics": {
              "configure": {
                "description": "Configura clientes de agentes na pasta atual"
              }
            }
          },
          "applications": {
            "description": "Consulta aplicações do workspace"
          },
          "demands": {
            "description": "Consulta melhorias e suas tarefas"
          },
          "issues": {
            "description": "Consulta e atualiza issues"
          },
          "monitoring": {
            "description": "Envia e consulta sinais de monitoramento"
          },
          "skills": {
            "description": "Gerencia as skills do workspace"
          }
        }
      }
    }
  },
  "scripts": {
    "start": "node bin/biaws.js",
    "format": "prettier --config ../prettier/.prettierrc --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../prettier/.prettierrc --ignore-path ../.prettierignore --check .",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "package:verify": "node scripts/verify-package.mjs",
    "release:check": "npm run format:check && npm run check && npm test && npm run package:verify",
    "publish:npm": "../scripts/publish-biaws-cli.sh",
    "prepack": "npm run package:verify"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@oclif/core": "^4.13.5"
  }
}
