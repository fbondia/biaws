server {
  listen 80;
  server_name _;
  client_max_body_size ${BIAWS_API_MAX_ATTACHMENT_BYTES};

  root /usr/share/nginx/html;
  index index.html;
  add_header Referrer-Policy "no-referrer" always;
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /api/ {
    proxy_pass http://api:3100;
    include /etc/nginx/proxy-api.conf;
  }

  location ^~ /.well-known/ {
    proxy_pass http://api:3100;
    include /etc/nginx/proxy-api.conf;
  }

  location = /mcp {
    set $mcp_enabled "${BIAWS_MCP_HTTP_ENABLED}";
    if ($mcp_enabled != "true") { return 404; }
    set $mcp_upstream http://mcp:3120;
    proxy_pass $mcp_upstream;
    include /etc/nginx/proxy-api.conf;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    client_max_body_size 16m;
    proxy_read_timeout 75s;
    proxy_send_timeout 30s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
